{
  "name": "sistema-veterinarias",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/copiar-standalone.mjs",
    "start": "prisma migrate deploy && node scripts/iniciar.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "migracion": "node scripts/nueva-migracion.mjs",
    "crear-usuario": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/crear-usuario.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@prisma/client": "6.19",
    "better-auth": "^1.7.12",
    "date-fns": "^4.4.0",
    "next": "16.4.3",
    "prisma": "6.19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  },
  "prisma": {
    "seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON prisma/seed.ts"
  }
}
