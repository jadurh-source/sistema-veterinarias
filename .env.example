# Copiar a .env y completar. .env no se sube a Git.

# PostgreSQL.
# Local: `npx prisma dev --name veterinarias --detach` y pegar acá la URL TCP (postgres://...),
# con connection_limit=1 (admite una sola conexión) y pgbouncer=true (sin esto falla con
# "prepared statement already exists" a partir de la segunda vez que se conecta).
# Railway: referencia al servicio Postgres -> ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1&pgbouncer=true

# Better Auth (Etapa 2). Generar el secreto con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# URL pública de la app. Local: http://localhost:3000 · Railway: https://<dominio>.up.railway.app
BETTER_AUTH_URL=http://localhost:3000

# Zona horaria para mostrar fechas e interpretar lo que carga el usuario
TZ_APP=America/Argentina/Tucuman

# Contraseña de los usuarios de demo del seed (dueno@demo.com y recepcion@demo.com)
DEMO_PASSWORD=
